<?xml version="1.0"?>
<package format="3">
  <name>nao_gz_control</name>
  <version>0.0.1</version>
  <description>Bringup for controlling NAO humanoid in Gazebo Harmonic with ROS 2 Jazzy.</description>
  <maintainer email="you@example.com">You</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>controller_manager</depend>
  <depend>controller_manager_msgs</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <depend>gazebo_ros2_control</depend>
  <depend>gz_ros2_control</depend>
  <depend>ros_gz</depend>

  <exec_depend>gazebo</exec_depend>
  <exec_depend>gz-sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
